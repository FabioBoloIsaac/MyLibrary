<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="FB_sweep" Id="{59b05527-a81a-46c0-8027-d759f6a264f9}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_sweep
VAR
	// VALORI DI INIZIALIZZAZIONE
	rStartFreq	:	REAL;
	rEndFreq	:	REAL;
	rLength		:	REAL;
	rK			:	REAL;
	
	// TIMER
	fbTimer			:	FB_Timer(T#0S);
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="ACTIONs" Id="{430fb45c-a939-46a0-9118-70ab8b1d3642}" />
    <Folder Name="METHODs" Id="{5bc75862-e8d2-426f-9b88-9dc79260b55d}" />
    <Method Name="ComputeFrequency" Id="{3e1a0425-0a5c-4887-ba37-1e1bfc692f05}" FolderPath="METHODs\">
      <Declaration><![CDATA[METHOD ComputeFrequency : REAL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ComputeFrequency	:=	F_interpolateReal(
	rX_Old	:=	0,
	rX_New	:=	rLength,
	rY_Old	:=	rStartFreq,
	rY_New	:=	rEndFreq,
	rX		:=	fbTimer.ComputeElapsedSeconds()
	);
	
	]]></ST>
      </Implementation>
    </Method>
    <Method Name="Initialize" Id="{4d178d43-3de9-4702-8bed-ac650e456d29}" FolderPath="METHODs\">
      <Declaration><![CDATA[METHOD Initialize : BOOL
VAR_INPUT
	rInputStartFrequency	:	REAL;
	rInputEndFrequency		:	REAL;
	rInputLength			:	REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[rStartFreq	:=	rInputStartFrequency;
rEndFreq	:=	rInputEndFrequency;
rLength		:=	rInputLength;
rK			:=	(rEndFreq - rStartFreq) / rLength;

fbTimer.ChangeTimer(F_seconds2Time(rLength));]]></ST>
      </Implementation>
    </Method>
    <Action Name="Start" Id="{39be2f7c-ee33-4e4c-838b-79b47bf8f887}" FolderPath="ACTIONs\">
      <Implementation>
        <ST><![CDATA[fbTimer.Reset();]]></ST>
      </Implementation>
    </Action>
    <Method Name="Step" Id="{38c0a492-17f1-43cd-ad95-a22e148d11c4}" FolderPath="METHODs\">
      <Declaration><![CDATA[METHOD Step : REAL
VAR_INPUT
END_VAR
VAR
	rTime	:	REAL;
	rFreq	:	REAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF fbTimer.VerifySelfElapsed() THEN
	Step	:=	0;
ELSE
	rTime	:=	fbTimer.ComputeElapsedSeconds();
	rFreq	:=	ComputeFrequency();
	Step	:=	SIN(CONSTANTS.PI * rTime * (2 * rStartFreq + rK + rTime));
END_IF
Step	:=	F_saturation(
	rInput			:=	Step,
	rMinimumValue	:=	-1,
	rMaximumValue	:=	+1
	);
]]></ST>
      </Implementation>
    </Method>
    <LineIds Name="FB_sweep">
      <LineId Id="9" Count="0" />
    </LineIds>
    <LineIds Name="FB_sweep.ComputeFrequency">
      <LineId Id="6" Count="7" />
      <LineId Id="5" Count="0" />
    </LineIds>
    <LineIds Name="FB_sweep.Initialize">
      <LineId Id="5" Count="0" />
      <LineId Id="10" Count="0" />
      <LineId Id="9" Count="0" />
      <LineId Id="13" Count="0" />
      <LineId Id="12" Count="0" />
      <LineId Id="11" Count="0" />
    </LineIds>
    <LineIds Name="FB_sweep.Start">
      <LineId Id="1" Count="0" />
    </LineIds>
    <LineIds Name="FB_sweep.Step">
      <LineId Id="18" Count="1" />
      <LineId Id="23" Count="0" />
      <LineId Id="25" Count="1" />
      <LineId Id="24" Count="0" />
      <LineId Id="20" Count="0" />
      <LineId Id="27" Count="4" />
      <LineId Id="15" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>