<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="F_time2seconds" Id="{8320d3a7-89fe-4fcd-accd-72e89d860407}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_time2seconds : REAL
VAR_INPUT
	tTime	:	TIME;
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[F_time2seconds	:=	TIME_TO_REAL(tTime) * CONVERSIONS.rTime2Seconds;]]></ST>
    </Implementation>
    <LineIds Name="F_time2seconds">
      <LineId Id="7" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>