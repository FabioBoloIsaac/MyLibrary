<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="F_interpolateTime" Id="{148c1805-e80b-47f2-bb0d-8ebe7a71cd82}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_interpolateTime : REAL
VAR_INPUT
	tX_Old	:	TIME;
	tX_New	:	TIME;
	rY_Old	:	REAL;
	rY_New	:	REAL;
	tX		:	TIME;
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[F_interpolateTime	:=	F_interpolateReal(
	rX_Old	:=	F_time2seconds(tX_Old),
	rX_New	:=	F_time2seconds(tX_New),
	rY_Old	:=	rY_Old,
	rY_New	:=	rY_New,
	rX		:=	F_time2seconds(tX)
	);
]]></ST>
    </Implementation>
    <LineIds Name="F_interpolateTime">
      <LineId Id="53" Count="0" />
      <LineId Id="56" Count="5" />
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>