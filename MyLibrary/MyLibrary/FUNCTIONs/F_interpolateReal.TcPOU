<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="F_interpolateReal" Id="{16274142-fa99-4bd3-bf9d-b116ca3bc947}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION F_interpolateReal : REAL
VAR_INPUT
	rX_Old	:	REAL;
	rX_New	:	REAL;
	rY_Old	:	REAL;
	rY_New	:	REAL;
	rX		:	REAL;
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF rX_Old <> rX_New THEN
	IF rX < rX_Old THEN
		F_interpolateReal	:=	rY_Old;
	ELSIF rX > rX_New THEN
		F_interpolateReal	:=	rY_New;
	ELSE
		F_interpolateReal	:=	rY_Old + (rY_New - rY_Old) / (rX_New - rX_Old) * (rX - rX_Old);
	END_IF
ELSE
	F_interpolateReal	:=	0;
END_IF]]></ST>
    </Implementation>
    <LineIds Name="F_interpolateReal">
      <LineId Id="33" Count="9" />
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>