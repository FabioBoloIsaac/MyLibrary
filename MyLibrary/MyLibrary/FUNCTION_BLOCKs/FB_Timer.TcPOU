<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.9">
  <POU Name="FB_Timer" Id="{1c7e49d7-0b84-41e9-bf71-580086c34571}" SpecialFunc="None">
    <Declaration><![CDATA[// CRONOMETRO: misura il tempo trascorso dall'ultimo Reset e lo confronta con una durata.
// Non serve chiamare il corpo del blocco: si usano solo metodi e action.
FUNCTION_BLOCK FB_Timer
VAR_INPUT
	tTimer		:	TIME;	// durata usata da VerifySelfElapsed
END_VAR
VAR
	tStartTime	:	TIME	:=	TIME() - tTimer;	// istante dell'ultimo Reset
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
]]></ST>
    </Implementation>
    <Folder Name="ACTIONs" Id="{65ec57ae-aace-4f74-9168-933038335526}" />
    <Folder Name="METHODs" Id="{b8755bcd-b80c-49c5-87a5-dae8f18a163c}" />
    <Method Name="ChangeTimer" Id="{ec14ba12-8668-4679-91c7-1c207881d044}" FolderPath="METHODs\">
      <Declaration><![CDATA[// IMPOSTA LA DURATA USATA DA VerifySelfElapsed (non fa ripartire il cronometro)
METHOD ChangeTimer
VAR_INPUT
	tTimerNew	:	TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tTimer	:=	tTimerNew;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ComputeElapsed" Id="{a50a418d-2f72-4912-800d-1c6a8b325b98}" FolderPath="METHODs\">
      <Declaration><![CDATA[// TEMPO TRASCORSO DALL'ULTIMO RESET
METHOD ComputeElapsed : TIME
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ComputeElapsed	:=	TIME() - tStartTime;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ComputeElapsedSeconds" Id="{dbb68b9c-c223-4ea3-93c9-0ff1dcc37603}" FolderPath="METHODs\">
      <Declaration><![CDATA[// TEMPO TRASCORSO DALL'ULTIMO RESET, IN SECONDI
METHOD ComputeElapsedSeconds : REAL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ComputeElapsedSeconds	:=	F_TimeToSeconds(ComputeElapsed());
]]></ST>
      </Implementation>
    </Method>
    <Action Name="Reset" Id="{82e45bc8-9b92-44a8-ae3c-9f0229c7d221}" FolderPath="ACTIONs\">
      <Implementation>
        <ST><![CDATA[// FA RIPARTIRE IL CRONOMETRO DA ZERO
tStartTime	:=	TIME();
]]></ST>
      </Implementation>
    </Action>
    <Method Name="ResetCondition" Id="{22784363-67a0-4843-8592-80fdd94ad69e}" FolderPath="METHODs\">
      <Declaration><![CDATA[// FA RIPARTIRE IL CRONOMETRO SOLO SE bCondition È TRUE.
// Restituisce TRUE se il reset è stato eseguito.
METHOD ResetCondition : BOOL
VAR_INPUT
	bCondition	:	BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF bCondition THEN
	Reset();
END_IF
ResetCondition	:=	bCondition;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetWithOffset" Id="{a9a5c184-95ea-4593-920b-fbd3201fa968}" FolderPath="METHODs\">
      <Declaration><![CDATA[// FA RIPARTIRE IL CRONOMETRO COME SE FOSSE GIÀ TRASCORSO tOffset
METHOD ResetWithOffset
VAR_INPUT
	tOffset	:	TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tStartTime	:=	TIME() - tOffset;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="VerifyElapsed" Id="{c27fb815-8bc4-4f79-9061-f28220489b90}" FolderPath="METHODs\">
      <Declaration><![CDATA[// TRUE SE DALL'ULTIMO RESET È TRASCORSO PIÙ DI tInputTime
METHOD VerifyElapsed : BOOL
VAR_INPUT
	tInputTime	:	TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[VerifyElapsed	:=	ComputeElapsed() > tInputTime;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="VerifySelfElapsed" Id="{8a8f8a9b-1b74-447b-aa6b-e346929972fb}" FolderPath="METHODs\">
      <Declaration><![CDATA[// TRUE SE DALL'ULTIMO RESET È TRASCORSO PIÙ DI tTimer
METHOD VerifySelfElapsed : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[VerifySelfElapsed	:=	ComputeElapsed() > tTimer;
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>